{
  "uid": "kics-cloudrag-lab",
  "title": "KICS CloudRAG \u2014 Enterprise Lab",
  "description": "Application, RAG, Redis, and ECS monitoring",
  "tags": [
    "kics",
    "cloudrag",
    "huawei",
    "ollama",
    "qdrant"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(cloudrag_http_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAG queries / second",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(cloudrag_rag_queries_total[5m]))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RAG response latency (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(cloudrag_rag_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Document retrieval latency (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(cloudrag_retrieval_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP response latency (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(cloudrag_http_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache hits (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "cloudrag_retrieval_cache_hits_total",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Document uploads (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "cloudrag_document_uploads_total",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ECS non-idle CPU (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ECS memory used (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API process running",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudrag-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"cloudrag-api\"}",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "h": 8,
